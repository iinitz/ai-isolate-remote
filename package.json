{
  "name": "@iinitz/ai-isolate-remote",
  "version": "1.1.0",
  "type": "module",
  "description": "Remote isolate driver for TanStack AI Code Mode — runs LLM-generated code in an isolated-vm sandbox on a remote executor server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iinitz/ai-isolate-remote.git"
  },
  "homepage": "https://github.com/iinitz/ai-isolate-remote#readme",
  "bugs": {
    "url": "https://github.com/iinitz/ai-isolate-remote/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "code-mode",
    "isolate",
    "isolated-vm",
    "sandbox",
    "code-execution",
    "remote"
  ],
  "engines": {
    "node": ">=22"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --no-node-snapshot --env-file-if-exists=.env --import tsx src/server/start.ts",
    "build": "tsc",
    "test": "node --import tsx src/server/wrap-code.test.ts",
    "start": "node --no-node-snapshot --env-file-if-exists=.env dist/server/start.js",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "@tanstack/ai-code-mode": "^0.4.1"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tanstack/ai-code-mode": "^0.4.1",
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
